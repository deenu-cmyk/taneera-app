rules_version = '2';

// ============================================================
// Taneera's — Firestore Security Rules
// ------------------------------------------------------------
// Deploy with: firebase deploy --only firestore:rules
// (requires firebase-tools; see README.md)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this in sync with ADMIN_EMAIL in firebase-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'tanirascollection@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------- PRODUCTS ----------------
    // Anyone (including signed-out visitors) can read the catalog.
    // Only the admin can create, edit, or delete products — this is
    // enforced here on the server, not just hidden in the UI, so a
    // customer editing the page's JavaScript still can't write.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------- CUSTOMERS ----------------
    // A signed-in user can read/write only their own profile doc.
    // The admin can read all customer profiles (for the Customers tab).
    // Also stores emailVerified + lastLoginAt (set by auth.js) — never a
    // password, Firebase Authentication owns that. Same rule as before;
    // no change needed for email verification support.
    match /customers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ---------------- ORDERS ----------------
    // Orders are created directly by the customer's browser (no payment
    // gateway or Cloud Function — this is a manual UPI/PhonePe QR flow).
    // A customer can only create an order under their own uid, and only
    // with paymentStatus starting at "Pending Verification" (never
    // self-declared as "Paid" — that requires the admin to manually
    // check the actual UPI/bank account and update it from the admin
    // dashboard). Customers can only READ their own orders; only the
    // admin can update status afterward (Placed → Processing → Shipped →
    // Delivered, and Payment Status → Paid/Failed).
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.paymentStatus == "Pending Verification";
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- COUPONS ----------------
    // Anyone can read coupons — customers need this to display "X% OFF"
    // badges and validate a code at checkout. Only the admin can create,
    // edit, activate/deactivate, or delete a coupon. Enforced here, not
    // just hidden in the UI.
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------- COUNTERS ----------------
    // A single doc (counters/invoices) used only to atomically hand out
    // sequential invoice numbers (INV-{year}-{seq}) when the admin marks
    // an order Paid. Admin-only in both directions — a customer being
    // able to read/write this could let them guess or corrupt the
    // invoice sequence for every order, not just their own.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
